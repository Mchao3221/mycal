{
  "name": "mycal",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && vite build",
    "css": "tailwindcss -i styles/workbench.css -o assets/workbench.css --minify",
    "sketch": "node scripts/build-sketch.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mycal_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mycal_db --remote",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler d1 migrations apply mycal_db --remote && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^4.20250902.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.7.27",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
